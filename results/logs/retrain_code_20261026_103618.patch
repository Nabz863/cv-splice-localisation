diff --git a/scripts/retrain_unet.sh b/scripts/retrain_unet.sh
new file mode 100755
index 0000000..2459c81
--- /dev/null
+++ b/scripts/retrain_unet.sh
@@ -0,0 +1,91 @@
+#!/bin/bash
+# Retrain every rung 4/5 U-Net with the resize-then-convolve decoder (unet.py)
+# and rebuild every table and figure from the new models.
+#
+# Run ONCE, on the cluster login node, from the repo root:
+#     bash scripts/retrain_unet.sh
+#
+# What it does:
+#   0. records the code being run: HEAD's hash, plus any uncommitted changes
+#      (tracked and new files) as results/logs/retrain_code_<time>.patch, which
+#      applies to that HEAD. Commit the same changes later and the results trace
+#      to the commit; until then they trace to HEAD + the patch.
+#   1. CPU checks: test_unet.py (decoder, sidecars, overfit) and test_mrf.py
+#   2. clears the start markers of any earlier, unfinished rerun, so that both
+#      GPU jobs begin by moving EVERY old-decoder output to results/stale/
+#      (nothing is deleted; refine_meta.py would refuse those files anyway)
+#   3. submits, in parallel:
+#        slurm/rerun_unet.sbatch      20 full-data models, rungs 4/5, per-image
+#                                     sweep, image-level AUC, mechanism,
+#                                     qualitative figure                ~20-24 h
+#        slurm/rerun_datasize.sbatch  80 models at n = 50/150/400/800, then the
+#                                     fp16 stabiliser comparison        ~20-24 h
+#      and a CPU job that waits for both to succeed, then runs
+#      scripts/rerun_cpu.sh: tests, rung 1-2 reruns, build_tables.py and
+#      make_figures.py                                                  ~1 h
+#
+# If a GPU job dies, resubmit THAT job directly (sbatch slurm/rerun_unet.sbatch);
+# it resumes. Do not rerun this script: it would move the new, partly finished
+# outputs aside and start again. FORCE=1 does exactly that, deliberately.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+export DATASETS=${DATASETS:-/datasets/nmahomed}
+mkdir -p results/logs
+
+MARK=results/.retrain_resize_submitted
+if [ -e "$MARK" ] && [ "${FORCE:-0}" != 1 ]; then
+  echo "Already submitted ($(cat "$MARK")). To resume a failed job, sbatch it directly."
+  echo "To discard the new outputs and start over: FORCE=1 bash $0"
+  exit 1
+fi
+
+# 0. Record exactly which code runs. The jobs read the working tree, so do not
+#    edit tracked code until all three jobs have finished.
+STAMP=$(date +%Y%m%d_%H%M%S)
+SNAP=results/logs/retrain_code_$STAMP.patch
+{
+  git diff HEAD --binary
+  git ls-files --others --exclude-standard -- src scripts slurm \
+    | while read -r f; do git diff --no-index --binary /dev/null "$f" || true; done
+} > "$SNAP"
+if [ -s "$SNAP" ]; then
+  echo "code: $(git rev-parse --short HEAD) + uncommitted changes, saved to $SNAP:"
+  git status --short -- src scripts slurm
+else
+  rm "$SNAP"; SNAP=""
+  echo "code: $(git rev-parse --short HEAD), no uncommitted changes"
+fi
+
+# 1. CPU checks before spending ~24 GPU-hours.
+set +u; source venv/bin/activate; set -u
+python3 src/methods/test_unet.py
+python3 src/methods/test_mrf.py
+grep -q '"upsample"' src/methods/refine_meta.py \
+  || { echo "refine_meta.py does not record the decoder - old models would be reused"; exit 1; }
+
+# 2. Fresh start for both jobs.
+for m in results/.rerun_unet_started results/.rerun_datasize_started; do
+  if [ -e "$m" ]; then rm "$m"; echo "cleared stale marker $m"; fi
+done
+
+# 3. Submit.
+J1=$(sbatch --parsable slurm/rerun_unet.sbatch)
+J2=$(sbatch --parsable slurm/rerun_datasize.sbatch)
+J3=$(sbatch --parsable --dependency=afterok:$J1:$J2 --kill-on-invalid-dep=yes \
+       --job-name=cv-tables --partition=bigbatch --time=6:00:00 --cpus-per-task=12 \
+       --output="$PWD/results/logs/retrain_tables_%j.log" \
+       --wrap "cd '$PWD' && set +u && source venv/bin/activate && set -u && \
+               DATASETS='$DATASETS' bash scripts/rerun_cpu.sh")
+
+echo "submitted $(date '+%a %d %b %H:%M'): unet=$J1 datasize=$J2 tables=$J3" \
+     "code=$(git rev-parse --short HEAD)${SNAP:+ + $SNAP}" | tee "$MARK"
+cat <<EOF
+
+Watch:   squeue -u \$USER
+Logs:    results/logs/rerun_unet_$J1.log
+         results/logs/rerun_datasize_$J2.log
+         results/logs/retrain_tables_$J3.log   (starts when both GPU jobs succeed)
+Done when the tables log ends with make_figures.py's output. Until then, leave
+src/, scripts/ and slurm/ untouched: later steps read the code when they start.
+Then commit the code and results/ together; the commit will match ${SNAP:-HEAD}.
+EOF
diff --git a/src/methods/test_unet.py b/src/methods/test_unet.py
new file mode 100644
index 0000000..045f146
--- /dev/null
+++ b/src/methods/test_unet.py
@@ -0,0 +1,115 @@
+"""Checks on the rung 4/5 network, CPU only, a few seconds.
+
+1. Both decoders map an H x W input (H, W multiples of 8) to H x W logits.
+2. The default decoder is resize-then-convolve and contains no transposed conv.
+3. The point of the switch: fed a constant feature map, the resize decoder's
+   upsampling gives a constant output (away from the zero-padded border), while
+   a 2x2 stride-2 transposed conv with random weights gives a period-2 pattern,
+   because each of the four positions in a 2x2 output block has its own weights.
+4. The constrained first layer still satisfies its constraint.
+5. refine_meta refuses a sidecar written before the "upsample" key existed.
+6. The network can overfit one synthetic batch (the wiring is right).
+
+Run from the repo root:  python3 src/methods/test_unet.py
+"""
+import json, os, sys, tempfile
+import torch
+
+sys.path.insert(0, os.path.dirname(__file__))
+from unet import UNet, up, dice_bce
+import refine_meta
+
+torch.manual_seed(0)
+
+
+def test_shapes():
+    for scheme in ("resize", "transpose"):
+        m = UNet(upsample=scheme).eval()
+        for h, w in ((64, 64), (72, 136)):
+            with torch.no_grad():
+                y = m(torch.rand(1, 3, h, w))
+            assert y.shape == (1, 1, h, w), (scheme, y.shape)
+    print("shapes ok")
+
+
+def test_default_has_no_transpose():
+    m = UNet()
+    assert m.upsample == "resize"
+    assert not any(isinstance(x, torch.nn.ConvTranspose2d) for x in m.modules())
+    n_new = sum(p.numel() for p in m.parameters())
+    n_old = sum(p.numel() for p in UNet(upsample="transpose").parameters())
+    print(f"no transposed convs; parameters {n_new/1e6:.3f} M (was {n_old/1e6:.3f} M)")
+
+
+def test_no_periodic_pattern():
+    x = torch.ones(1, 16, 8, 8)
+    for scheme, expect_flat in (("resize", True), ("transpose", False)):
+        u = up(16, 4, scheme)
+        with torch.no_grad():
+            y = u(x)[0, :, 2:-2, 2:-2]                 # interior: no padding effects
+        # spread of each channel over the four positions of the 2x2 phase grid
+        phases = torch.stack([y[:, i::2, j::2].mean(dim=(1, 2))
+                              for i in (0, 1) for j in (0, 1)])
+        spread = (phases.max(0).values - phases.min(0).values).max().item()
+        flat = spread < 1e-5
+        assert flat == expect_flat, (scheme, spread)
+        print(f"{scheme:<9} constant in -> phase spread {spread:.2e} "
+              f"({'flat' if flat else 'period-2 pattern'})")
+
+
+def test_constraint():
+    m = UNet()
+    m.pre.weight.data.normal_()
+    m.constrain()
+    w = m.pre.weight.data
+    c = m.pre.k // 2
+    assert torch.allclose(w[:, :, c, c], torch.full_like(w[:, :, c, c], -1.0))
+    surround = w.sum(dim=(2, 3)) - w[:, :, c, c]
+    assert torch.allclose(surround, torch.ones_like(surround), atol=1e-5)
+    print("constrained layer ok")
+
+
+def test_old_sidecar_refused():
+    cfg = {k: 0 for k in refine_meta.KEYS}
+    cfg["upsample"] = "resize"
+    with tempfile.TemporaryDirectory() as d:
+        p = os.path.join(d, "m.pt")
+        refine_meta.write(p, cfg)
+        refine_meta.check(p, cfg)                      # same config: accepted
+        old = {k: v for k, v in cfg.items() if k != "upsample"}
+        json.dump(old, open(refine_meta.sidecar(p), "w"))
+        try:
+            refine_meta.check(p, cfg)
+        except SystemExit:
+            print("pre-switch sidecar refused")
+        else:
+            raise AssertionError("a sidecar without 'upsample' was accepted")
+
+
+def test_overfit():
+    m = UNet()
+    opt = torch.optim.Adam(m.parameters(), lr=1e-3)
+    x = torch.rand(2, 3, 64, 64)
+    y = torch.zeros(2, 1, 64, 64)
+    y[:, :, 16:40, 20:44] = 1
+    m.constrain()
+    first = None
+    for _ in range(60):
+        opt.zero_grad()
+        loss = dice_bce(m(x), y)
+        loss.backward()
+        opt.step()
+        m.constrain()
+        first = first if first is not None else loss.item()
+    assert loss.item() < 0.5 * first, (first, loss.item())
+    print(f"overfits one batch: loss {first:.3f} -> {loss.item():.3f}")
+
+
+if __name__ == "__main__":
+    test_shapes()
+    test_default_has_no_transpose()
+    test_no_periodic_pattern()
+    test_constraint()
+    test_old_sidecar_refused()
+    test_overfit()
+    print("test_unet: all passed")
